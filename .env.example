# Local Postgres from docker-compose.yml
DATABASE_URL=postgres://ledger:ledger@localhost:5432/joint_ledger

# Optional: Neon in production. Local Postgres is enough for M1/M2.
# DATABASE_URL=postgres://USER:PASSWORD@HOST/neondb?sslmode=require

# Optional Twelve Data key. Server-side only — never NEXT_PUBLIC_*.
# With a key: Twelve Data only (no public quote sources).
# Empty: server uses public delayed quotes (crypto Binance → CoinGecko;
# stocks/FX/index Yahoo unofficial chart, marked delayed). Browser still
# only hits /api/quotes, /api/ohlcv, tape. Unmarked lots stay 部分市值.
TWELVE_DATA_API_KEY=

# Basic plan daily cap. Near this limit the app stops calling Twelve Data
# and serves last-good quotes instead.
# TWELVE_DATA_DAILY_CREDIT_CAP=800

# Optional Finnhub key. Server-side only — never NEXT_PUBLIC_*.
# Used for news only (company-news / market news). Never quote.
# Empty → server fetches Google News public RSS (zh-HK). Never NEXT_PUBLIC_*.
# With a key, Finnhub only — 429/fail does not fall back to RSS.
FINNHUB_API_KEY=
