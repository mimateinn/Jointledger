{
  "name": "joint-ledger",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.3",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "test:ledger-filter": "node scripts/ledger-filter-stress.mjs",
    "test:scroll-width": "node scripts/measure-scroll-width.mjs",
    "test:sticky": "node scripts/measure-sticky.mjs",
    "test:watch-actions": "node scripts/measure-watch-actions.mjs",
    "db:generate": "drizzle-kit generate",
    "db:generate:sqlite": "drizzle-kit generate --config drizzle.config.sqlite.ts",
    "db:migrate": "tsx src/db/migrate.ts"
  },
  "dependencies": {
    "@libsql/client": "^0.15.15",
    "@node-rs/argon2": "^2.0.2",
    "@serwist/next": "^9.2.1",
    "decimal.js": "^10.6.0",
    "drizzle-orm": "^0.44.5",
    "exceljs": "^4.4.0",
    "lightweight-charts": "^5.2.1",
    "next": "^15.5.2",
    "postgres": "^3.4.7",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "serwist": "^9.2.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "dotenv": "^16.6.1",
    "drizzle-kit": "^0.31.4",
    "eslint": "^9.34.0",
    "eslint-config-next": "^15.5.2",
    "jsdom": "^30.1.2",
    "puppeteer-core": "^25.12.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "libsql",
      "sharp",
      "unrs-resolver"
    ]
